diff --git a/lib/auth/auth_error.dart b/lib/auth/auth_error.dart
new file mode 100644
index 0000000..d9c50e2
--- /dev/null
+++ b/lib/auth/auth_error.dart
@@ -0,0 +1,35 @@
+import 'package:flutter_common/l10n/app_localizations.dart';
+
+/// Maps an error of the auth flow to a message that can be shown to the user.
+///
+/// The raw errors of the supabase client are technical and contain the whole
+/// response of the server, for example:
+///
+///   AuthRetryableFetchException(message: {"code":"unexpected_failure",
+///     "message":"Database error saving new user"}, statusCode: 500)
+///
+/// They are replaced by a short message, the details are only logged.
+String authErrorMessage(Object error, AppLocalizations l10n) {
+  final message = error.toString();
+  if (message.contains('Database error saving new user')) {
+    // The database rejected the new user, this happens when rows of a
+    // previously deleted account are still in the database.
+    return l10n.cannotRegisterEmail;
+  }
+  if (message.contains('User already registered') ||
+      message.contains('email_exists')) {
+    return l10n.emailAlreadyRegistered;
+  }
+  if (message.contains('Email not confirmed')) {
+    return l10n.emailNotConfirmed;
+  }
+  if (message.contains('Invalid login credentials')) {
+    return l10n.invalidCredentials;
+  }
+  if (message.contains('Failed to fetch') ||
+      message.contains('SocketException') ||
+      message.contains('Connection refused')) {
+    return l10n.networkError;
+  }
+  return message;
+}
diff --git a/lib/auth/auth_provider.dart b/lib/auth/auth_provider.dart
index 1f614f5..c8677b6 100644
--- a/lib/auth/auth_provider.dart
+++ b/lib/auth/auth_provider.dart
@@ -197,10 +197,17 @@ class SupabaseAuth extends AuthProvider {
     if (token == null) {
       throw 'No Token';
     }
-    await supabase.functions.invoke(
+    final response = await supabase.functions.invoke(
       'delete-account',
       headers: {'Authorization': 'Bearer $token'},
     );
+    // The result has to be checked, otherwise a failed deletion is reported as
+    // a success. The account is then half deleted: the auth user is gone but
+    // the rows that belong to the email are still in the database, which makes
+    // it impossible to register the same email again.
+    if (response.status < 200 || response.status >= 300) {
+      throw 'Delete account failed: ${response.status}';
+    }
     supabase.auth.signOut();
   }
 }
